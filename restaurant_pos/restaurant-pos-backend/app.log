Hibernate: 
    SELECT
        COUNT(DISTINCT o.id)                             AS totalOrders,
        COALESCE(SUM(o.total_amount), 0)                 AS totalRevenue,
        COALESCE(SUM(CASE 
            WHEN p.payment_method = 'CASH'            
                THEN p.amount 
            ELSE 0 
    END), 0)                AS cashAmount,
    COALESCE(SUM(CASE 
        WHEN p.payment_method = 'CREDIT_CARD'            
            THEN p.amount 
        ELSE 0 
END), 0)                AS cardAmount,
COALESCE(SUM(CASE 
    WHEN p.payment_method = 'LINE_PAY'            
        THEN p.amount 
    ELSE 0 
END), 0)                AS otherAmount 
FROM
    orders o 
JOIN
    payment p 
        ON p.order_id = o.id 
WHERE
    o.status = 'PAID'   
    AND DATE(o.paid_at) = ? 
